# Copy this file to .streamlit/secrets.toml (which git ignores) and fill in real values.
# Never commit the real file. The same four names are used as GitHub Secrets and
# in Streamlit Community Cloud > App settings > Secrets.

# Supabase > Project Settings > API Keys
SUPABASE_URL = "https://<project-ref>.supabase.co"
SUPABASE_ANON_KEY = "<publishable or anon key>"

# Supabase > Connect > Session pooler (port 5432), with the user and password swapped in
RUNNER_DSN = "postgresql://quiz_runner.<project-ref>:<runner-password>@<pooler-host>:5432/postgres?sslmode=require"
APP_DSN = "postgresql://quiz_app.<project-ref>:<app-password>@<pooler-host>:5432/postgres?sslmode=require"
